{
  "schema": "config-merge-cases.v1",
  "scope": "exposed development case; each CLI action runs in a fresh process against the same per-case sandbox file; independent_task_increment=0",
  "independent_task_increment": 0,
  "cases": [
    {
      "name": "recursive-delete-retain",
      "seed_file": "{\"ui\":{\"theme\":{\"fg\":\"white\",\"bg\":\"black\",\"keep\":1},\"enabled\":true},\"unknown\":{\"retained\":[1,null]},\"remove\":9}",
      "actions": [
        {
          "id": "merge-recursive",
          "args": [
            "merge",
            "$CONFIG",
            "{\"ui\":{\"theme\":{\"fg\":\"green\",\"bg\":null,\"added\":2}},\"remove\":null,\"absent\":null}"
          ],
          "expected": {
            "exit_code": 0,
            "stdout_json": {
              "status": "merged",
              "key": null
            },
            "file_json": {
              "ui": {
                "theme": {
                  "fg": "green",
                  "keep": 1,
                  "added": 2
                },
                "enabled": true
              },
              "unknown": {
                "retained": [
                  1,
                  null
                ]
              }
            }
          }
        },
        {
          "id": "reopen",
          "args": [
            "show",
            "$CONFIG"
          ],
          "expected": {
            "exit_code": 0,
            "stdout_json": {
              "ui": {
                "theme": {
                  "fg": "green",
                  "keep": 1,
                  "added": 2
                },
                "enabled": true
              },
              "unknown": {
                "retained": [
                  1,
                  null
                ]
              }
            },
            "file_json": {
              "ui": {
                "theme": {
                  "fg": "green",
                  "keep": 1,
                  "added": 2
                },
                "enabled": true
              },
              "unknown": {
                "retained": [
                  1,
                  null
                ]
              }
            }
          }
        }
      ],
      "why": "为什么要有它：验证两层递归、删除、未知字段保留及新进程重读，不能只检查顶层替换。"
    },
    {
      "name": "object-over-nonobjects",
      "seed_file": "{\"scalar\":3,\"array\":[1,2],\"nil\":null,\"boolean\":false,\"keep\":8}",
      "actions": [
        {
          "id": "objects",
          "args": [
            "merge",
            "$CONFIG",
            "{\"scalar\":{\"inner\":{\"ok\":1},\"gone\":null},\"array\":{\"inside\":[]},\"nil\":{\"k\":2},\"boolean\":{\"missing\":null}}"
          ],
          "expected": {
            "exit_code": 0,
            "stdout_json": {
              "status": "merged",
              "key": null
            },
            "file_json": {
              "scalar": {
                "inner": {
                  "ok": 1
                }
              },
              "array": {
                "inside": []
              },
              "nil": {
                "k": 2
              },
              "boolean": {},
              "keep": 8
            }
          }
        },
        {
          "id": "reopen",
          "args": [
            "show",
            "$CONFIG"
          ],
          "expected": {
            "exit_code": 0,
            "stdout_json": {
              "scalar": {
                "inner": {
                  "ok": 1
                }
              },
              "array": {
                "inside": []
              },
              "nil": {
                "k": 2
              },
              "boolean": {},
              "keep": 8
            },
            "file_json": {
              "scalar": {
                "inner": {
                  "ok": 1
                }
              },
              "array": {
                "inside": []
              },
              "nil": {
                "k": 2
              },
              "boolean": {},
              "keep": 8
            }
          }
        }
      ],
      "why": "为什么要有它：对象补丁覆盖非对象时必须从空对象递归，不能把null删除标记存下来。"
    },
    {
      "name": "whole-value-replacement",
      "seed_file": "{\"items\":[1,2,3],\"obj\":{\"x\":1},\"text\":\"old\",\"num\":1,\"keep\":{\"x\":1}}",
      "actions": [
        {
          "id": "replace-values",
          "args": [
            "merge",
            "$CONFIG",
            "{\"items\":[{\"x\":null},[1,2],null],\"obj\":8,\"text\":false,\"num\":\"now-string\"}"
          ],
          "expected": {
            "exit_code": 0,
            "stdout_json": {
              "status": "merged",
              "key": null
            },
            "file_json": {
              "items": [
                {
                  "x": null
                },
                [
                  1,
                  2
                ],
                null
              ],
              "obj": 8,
              "text": false,
              "num": "now-string",
              "keep": {
                "x": 1
              }
            }
          }
        },
        {
          "id": "reopen",
          "args": [
            "show",
            "$CONFIG"
          ],
          "expected": {
            "exit_code": 0,
            "stdout_json": {
              "items": [
                {
                  "x": null
                },
                [
                  1,
                  2
                ],
                null
              ],
              "obj": 8,
              "text": false,
              "num": "now-string",
              "keep": {
                "x": 1
              }
            },
            "file_json": {
              "items": [
                {
                  "x": null
                },
                [
                  1,
                  2
                ],
                null
              ],
              "obj": 8,
              "text": false,
              "num": "now-string",
              "keep": {
                "x": 1
              }
            }
          }
        }
      ],
      "why": "为什么要有它：数组整体替换且数组内部null是数据，标量替换不得误用对象递归。"
    },
    {
      "name": "case-sensitive-keys",
      "seed_file": "{\"Name\":1,\"name\":2,\"nested\":{\"Key\":8,\"key\":9},\"标签\":\"保留\"}",
      "actions": [
        {
          "id": "case-sensitive",
          "args": [
            "merge",
            "$CONFIG",
            "{\"name\":4,\"nested\":{\"key\":7}}"
          ],
          "expected": {
            "exit_code": 0,
            "stdout_json": {
              "status": "merged",
              "key": null
            },
            "file_json": {
              "Name": 1,
              "name": 4,
              "nested": {
                "Key": 8,
                "key": 7
              },
              "标签": "保留"
            }
          }
        },
        {
          "id": "reopen",
          "args": [
            "show",
            "$CONFIG"
          ],
          "expected": {
            "exit_code": 0,
            "stdout_json": {
              "Name": 1,
              "name": 4,
              "nested": {
                "Key": 8,
                "key": 7
              },
              "标签": "保留"
            },
            "file_json": {
              "Name": 1,
              "name": 4,
              "nested": {
                "Key": 8,
                "key": 7
              },
              "标签": "保留"
            }
          }
        }
      ],
      "why": "为什么要有它：不同大小写的键必须保持独立，同时验证非ASCII键。"
    },
    {
      "name": "empty-existing-object",
      "seed_file": " { \"unknown\" : [1,null], \"x\" : {\"y\":2} }\n",
      "actions": [
        {
          "id": "empty",
          "args": [
            "merge",
            "$CONFIG",
            "{}"
          ],
          "expected": {
            "exit_code": 0,
            "stdout_json": {
              "status": "merged",
              "key": null
            },
            "file_json": {
              "unknown": [
                1,
                null
              ],
              "x": {
                "y": 2
              }
            }
          }
        },
        {
          "id": "reopen",
          "args": [
            "show",
            "$CONFIG"
          ],
          "expected": {
            "exit_code": 0,
            "stdout_json": {
              "unknown": [
                1,
                null
              ],
              "x": {
                "y": 2
              }
            },
            "file_json": {
              "unknown": [
                1,
                null
              ],
              "x": {
                "y": 2
              }
            }
          }
        }
      ],
      "why": "为什么要有它：空补丁保留语义内容，不要求成功写入保持原格式。"
    },
    {
      "name": "missing-create-object",
      "seed_file": null,
      "actions": [
        {
          "id": "create",
          "args": [
            "merge",
            "$CONFIG",
            "{\"a\":{\"b\":1,\"absent\":null},\"array\":[null],\"gone\":null}"
          ],
          "expected": {
            "exit_code": 0,
            "stdout_json": {
              "status": "merged",
              "key": null
            },
            "file_json": {
              "a": {
                "b": 1
              },
              "array": [
                null
              ]
            }
          }
        },
        {
          "id": "reopen",
          "args": [
            "show",
            "$CONFIG"
          ],
          "expected": {
            "exit_code": 0,
            "stdout_json": {
              "a": {
                "b": 1
              },
              "array": [
                null
              ]
            },
            "file_json": {
              "a": {
                "b": 1
              },
              "array": [
                null
              ]
            }
          }
        }
      ],
      "why": "为什么要有它：缺失文件和目录允许由有效对象补丁创建，删除不存在字段不应留下null。"
    },
    {
      "name": "missing-empty-object",
      "seed_file": null,
      "actions": [
        {
          "id": "create-empty",
          "args": [
            "merge",
            "$CONFIG",
            "{}"
          ],
          "expected": {
            "exit_code": 0,
            "stdout_json": {
              "status": "merged",
              "key": null
            },
            "file_json": {}
          }
        },
        {
          "id": "reopen",
          "args": [
            "show",
            "$CONFIG"
          ],
          "expected": {
            "exit_code": 0,
            "stdout_json": {},
            "file_json": {}
          }
        }
      ],
      "why": "为什么要有它：空对象也是有效补丁，缺失目标必须形成对象文件。"
    },
    {
      "name": "root-null-existing",
      "seed_file": " { \"keep\" : 42 }\r\n",
      "actions": [
        {
          "id": "reject-root",
          "args": [
            "merge",
            "$CONFIG",
            "null"
          ],
          "expected": {
            "exit_code": 2,
            "stdout_json": {
              "status": "rejected",
              "key": null
            },
            "file_unchanged": true
          }
        }
      ],
      "why": "为什么要有它：根补丁仅允许对象；拒绝不得改动既有字节或创建缺失文件。"
    },
