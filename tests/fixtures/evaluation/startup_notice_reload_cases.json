    {
      "name": "state_transitions",
      "seed_config": null,
      "initial": {
        "enabled": true,
        "message": "Ready"
      },
      "why": "为什么要有它：停用和空白也更新上次有效状态，重新启用或恢复消息时应恢复一次提示。",
      "reload_actions": [
        {
          "id": "unchanged",
          "config_text": "[General]\nEnabled = true\nMessage = Ready\n",
          "expected": {
            "enabled": true,
            "message": "Ready",
            "logs": []
          }
        },
        {
          "id": "message_change",
          "config_text": "[General]\nEnabled = true\nMessage = Alpha\n",
          "expected": {
            "enabled": true,
            "message": "Alpha",
            "logs": [
              {
                "level": "Info",
                "message": "Alpha"
              }
            ]
          }
        },
        {
          "id": "repeat",
          "config_text": "# formatting only\n[General]\nMessage = Alpha\nEnabled = true\n",
          "expected": {
            "enabled": true,
            "message": "Alpha",
            "logs": []
          }
        },
        {
          "id": "disable_and_change",
          "config_text": "[General]\nMessage = Beta\nEnabled = false\n",
          "expected": {
            "enabled": false,
            "message": "Beta",
            "logs": []
          }
        },
        {
          "id": "disabled_message_change",
          "config_text": "[General]\nEnabled = false\nMessage = Gamma\n",
          "expected": {
            "enabled": false,
            "message": "Gamma",
            "logs": []
          }
        },
        {
          "id": "reenable",
          "config_text": "[General]\nEnabled = true\nMessage = Gamma\n",
          "expected": {
            "enabled": true,
            "message": "Gamma",
            "logs": [
              {
                "level": "Info",
                "message": "Gamma"
              }
            ]
          }
        },
        {
          "id": "empty",
          "config_text": "[General]\nEnabled = true\nMessage = \n",
          "expected": {
            "enabled": true,
            "message": "",
            "logs": []
          }
        },
        {
          "id": "whitespace",
          "config_text": "[General]\nEnabled = true\nMessage =    \t  \n",
          "expected": {
            "enabled": true,
            "message": "",
            "logs": []
          }
        },
        {
          "id": "restore",
          "config_text": "[General]\nEnabled = true\nMessage = Ready\n",
          "expected": {
            "enabled": true,
            "message": "Ready",
            "logs": [
              {
                "level": "Info",
                "message": "Ready"
              }
            ]
          }
        },
        {
          "id": "repeat_restored",
          "config_text": "[General]\nEnabled = true\nMessage = Ready\n",
          "expected": {
            "enabled": true,
            "message": "Ready",
            "logs": []
          }
        }
      ]
    },
