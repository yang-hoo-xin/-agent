            "enabled": true,
            "message": "Latest",
            "logs": [
              {
                "level": "Info",
                "message": "Latest"
              }
            ]
          }
        },
        {
          "id": "repeat_latest",
          "config_text": "[General]\nEnabled = true\nMessage = Latest\n",
          "expected": {
            "enabled": true,
            "message": "Latest",
            "logs": []
          }
        }
      ]
    },
    {
      "name": "comparison_and_unrelated_settings",
      "seed_config": "[General]\nEnabled = true\nMessage = Alpha\n",
      "initial": {
        "enabled": true,
        "message": "Alpha"
      },
      "why": "为什么要有它：消息比较保留大小写，未改变General两项的其他配置不能触发提示，禁用后重启不能误去重。",
      "reload_actions": [
        {
          "id": "same",
          "config_text": "[General]\nEnabled = true\nMessage = Alpha\n",
          "expected": {
            "enabled": true,
            "message": "Alpha",
            "logs": []
          }
        },
        {
          "id": "case_change",
          "config_text": "[General]\nEnabled = true\nMessage = alpha\n",
          "expected": {
            "enabled": true,
            "message": "alpha",
            "logs": [
              {
                "level": "Info",
                "message": "alpha"
              }
            ]
          }
        },
        {
          "id": "clear",
          "config_text": "[General]\nEnabled = true\nMessage = \n",
          "expected": {
            "enabled": true,
            "message": "",
            "logs": []
          }
        },
        {
          "id": "disabled_new_text",
          "config_text": "[General]\nEnabled = false\nMessage = Alpha\n",
          "expected": {
            "enabled": false,
            "message": "Alpha",
            "logs": []
          }
        },
        {
          "id": "reenabled_previous_text",
          "config_text": "[General]\nEnabled = true\nMessage = Alpha\n",
          "expected": {
            "enabled": true,
            "message": "Alpha",
            "logs": [
              {
                "level": "Info",
                "message": "Alpha"
              }
            ]
          }
        },
        {
          "id": "unrelated_only",
          "config_text": "[General]\nEnabled = true\nMessage = Alpha\n\n[Unrelated]\nSetting = changed\n",
          "expected": {
            "enabled": true,
            "message": "Alpha",
            "logs": []
          }
        },
        {
          "id": "next_text",
          "config_text": "[General]\nEnabled = true\nMessage = Beta\n",
          "expected": {
            "enabled": true,
            "message": "Beta",
            "logs": [
              {
                "level": "Info",
                "message": "Beta"
              }
            ]
          }
        }
      ]
