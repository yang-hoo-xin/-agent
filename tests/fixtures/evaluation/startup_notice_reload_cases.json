  "scope": "Cold real BasePlugin.Load followed by real ConfigFile.Reload in the same process; plugin constructor, Chainloader, file watcher and game are not executed.",
  "state_comparison": "After Load and after every completed Reload remember actual Enabled and Message values, including disabled or blank states; ordinal string comparison.",
  "cases": [
    {
      "name": "fresh",
      "seed_config": null,
      "initial": {
        "enabled": true,
        "message": "Ready"
      },
      "reload_actions": [],
      "why": "为什么要有它：保留已交付首次Load的默认、显式值、禁用及空白抑制行为。"
    },
    {
      "name": "stored_true_custom",
      "seed_config": "[General]\nEnabled = true\nMessage = Explicit custom message\n",
