      "reload_actions": [],
      "why": "为什么要有它：保留已交付首次Load的默认、显式值、禁用及空白抑制行为。"
    },
    {
      "name": "stored_false_custom",
      "seed_config": "[General]\nEnabled = false\nMessage = Disabled custom message\n",
      "initial": {
        "enabled": false,
        "message": "Disabled custom message"
      },
      "reload_actions": [],
      "why": "为什么要有它：保留已交付首次Load的默认、显式值、禁用及空白抑制行为。"
    },
