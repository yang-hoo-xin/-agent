          "id": "enable_same_text",
          "config_text": "[General]\nEnabled = true\nMessage = Sticky\n",
          "expected": {
            "enabled": true,
            "message": "Sticky",
            "logs": [
              {
                "level": "Info",
                "message": "Sticky"
              }
            ]
          }
        },
        {
          "id": "blank_same_enabled",
          "config_text": "[General]\nEnabled = true\nMessage = \n",
          "expected": {
            "enabled": true,
            "message": "",
            "logs": []
          }
        },
        {
          "id": "restore_same_text",
          "config_text": "[General]\nEnabled = true\nMessage = Sticky\n",
          "expected": {
            "enabled": true,
            "message": "Sticky",
            "logs": [
              {
                "level": "Info",
                "message": "Sticky"
              }
            ]
          }
