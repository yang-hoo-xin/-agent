      "name": "stored_whitespace",
      "seed_config": "[General]\nEnabled = true\nMessage =    \t  \n",
      "initial": {
        "enabled": true,
        "message": ""
      },
      "reload_actions": [],
      "why": "为什么要有它：保留已交付首次Load的默认、显式值、禁用及空白抑制行为。"
